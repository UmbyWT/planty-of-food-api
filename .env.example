# Copia questo file in .env e adatta i valori al tuo database.
# I valori di esempio coincidono con quelli di docker-compose.yml.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pof
DB_PASSWORD=pof_password
DB_NAME=pof

# Solo per i test di integrazione. Devono usare un database a parte, il cui nome
# contiene "test": i test ne cancellano le tabelle a ogni esecuzione.
TEST_DB_NAME=pof_test
