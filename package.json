{
  "name": "planty-of-food-api",
  "version": "1.0.0",
  "description": "API REST per i gruppi di acquisto di Planty of Food (POF)",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test 'test/unit/**/*.test.js'",
    "test:integration": "node --test --test-concurrency=1 'test/integration/**/*.test.js'",
    "test:all": "node --test --test-concurrency=1 'test/unit/**/*.test.js' 'test/integration/**/*.test.js'",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-concurrency=1 'test/unit/**/*.test.js' 'test/integration/**/*.test.js'"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sinon": "^22.1.0",
    "supertest": "^7.3.1"
  }
}
